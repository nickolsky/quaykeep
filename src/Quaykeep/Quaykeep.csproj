<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>Quaykeep</AssemblyTitle>
    <!-- regenerate with the write-icons switch of Quaykeep (Program.Main) after changing IconFactory drawing -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- AVLN3001: windows without a public parameterless constructor (they take the host) -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quaykeep.Core\Quaykeep.Core.csproj" />
    <ProjectReference Include="..\qk\qk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Quaykeep.Core.Localization" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- Fluent UI System Icons (MIT): the same icons on every OS (Segoe Fluent Icons exists only on Windows) -->
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.344" />
    <!-- built-in terminal and editor: the system web engine (WebView2, WKWebView, WebKitGTK) -->
    <PackageReference Include="NativeWebView" Version="12.0.4.9" />
    <PackageReference Include="NativeWebView.Platform.Windows" Version="12.0.4.9" />
    <PackageReference Include="NativeWebView.Platform.macOS" Version="12.0.4.9" />
    <PackageReference Include="NativeWebView.Platform.Linux" Version="12.0.4.9" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- Windows session lock (SessionSwitch); Linux session lock and idle time over D-Bus (Avalonia.FreeDesktop already ships this version) -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.12" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- built-in terminal page (xterm.js), loaded by the web view from the app folder -->
    <Content Include="Assets\terminal\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- built-in editor page (CodeMirror 6, bundle built from tools\codemirror) -->
    <Content Include="Assets\editor\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Skia and HarfBuzz ship ~100 MB of native debug symbols; keep them out of the published app. -->
  <Target Name="DropDebugSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
