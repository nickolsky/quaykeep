<v:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Quaykeep.Views"
        xmlns:l="using:Quaykeep.Localization"
        x:Class="Quaykeep.Views.UnlockWindow"
        Title="Quaykeep" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" CanResize="False" Topmost="True" ShowInTaskbar="True">
    <StackPanel Margin="24">
        <TextBlock x:Name="Header" FontSize="20" FontWeight="SemiBold" Text="{l:Tr Unlock.Header}" />
        <TextBlock x:Name="Subtitle" Classes="hint" Margin="0,6,0,0" Text="{l:Tr Unlock.Subtitle}" />

        <TextBlock Classes="fieldLabel" Text="{l:Tr Unlock.Password}" />
        <TextBox x:Name="Password" PasswordChar="•" />

        <StackPanel x:Name="CreatePanel" IsVisible="False">
            <TextBlock Classes="fieldLabel" Text="{l:Tr Unlock.Repeat}" />
            <TextBox x:Name="Confirm" PasswordChar="•" />
            <CheckBox x:Name="AutostartBox" Margin="0,14,0,0" IsChecked="True" Content="{l:Tr Unlock.Autostart}" />
            <TextBlock Classes="hint" Margin="0,10,0,0" Text="{l:Tr Unlock.CryptoHint}" />
        </StackPanel>

        <TextBlock x:Name="Error" Foreground="#E0443E" TextWrapping="Wrap" Margin="0,10,0,0" IsVisible="False" />
        <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="4" MinHeight="4" Margin="0,12,0,0" Opacity="0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="{l:Tr Unlock.Unlock}" IsDefault="True" Click="OnOk"
                    Classes="accent" MinWidth="130" HorizontalContentAlignment="Center" />
            <Button Content="{l:Tr Common.Cancel}" IsCancel="True" Classes="dialog" />
        </StackPanel>
    </StackPanel>
</v:DialogWindow>
