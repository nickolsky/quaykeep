<v:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Quaykeep.Views"
        xmlns:l="using:Quaykeep.Localization"
        x:Class="Quaykeep.Views.KeySetupWindow"
        Title="{l:Tr KeySetup.Title}" Width="640" Height="560" MinWidth="480" MinHeight="420">
    <Grid Margin="24,16,24,20" RowDefinitions="Auto,Auto,*,Auto,Auto">
        <TextBlock x:Name="Header" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Margin="0,10,0,10">
            <TextBlock Classes="hint" Text="{l:Tr KeySetup.Hint}" />
            <TextBlock Classes="fieldLabel" Text="{l:Tr Editor.Key}" />
            <ComboBox x:Name="KeyBox" DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" />
            <CheckBox x:Name="DisablePasswordBox" Content="{l:Tr KeySetup.DisablePassword}" Margin="0,12,0,0" />
            <TextBlock Classes="hint" Text="{l:Tr KeySetup.DisablePasswordHint}" Margin="22,4,0,0" />
        </StackPanel>
        <TextBox x:Name="Log" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" Classes="mono" AcceptsReturn="True"
                 VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <ProgressBar x:Name="Busy" Grid.Row="3" IsIndeterminate="True" Height="4" MinHeight="4" Margin="0,10,0,0" Opacity="0" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="StartButton" Content="{l:Tr KeySetup.Start}" IsDefault="True" Click="OnStart"
                    Classes="accent" MinWidth="110" HorizontalContentAlignment="Center" />
            <Button x:Name="CloseButton" Content="{l:Tr Common.Close}" IsCancel="True" Classes="dialog" />
        </StackPanel>
    </Grid>
</v:DialogWindow>
