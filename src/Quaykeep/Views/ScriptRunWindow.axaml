<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Quaykeep.Localization"
        x:Class="Quaykeep.Views.ScriptRunWindow"
        Title="{l:Tr ScriptRun.Title}" Width="860" Height="720" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- one row per script parameter; the editor depends on Kind -->
        <DataTemplate x:Key="ParamRow">
            <Grid Margin="0,0,0,10" ColumnDefinitions="230,*" RowDefinitions="Auto,Auto" IsVisible="{Binding IsVisible}">
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" ToolTip.Tip="{Binding Name}" />
                <TextBox Grid.Column="1" Text="{Binding Value}" IsVisible="{Binding IsText}" />
                <TextBox Grid.Column="1" Text="{Binding Value}" IsVisible="{Binding IsNumber}" HorizontalAlignment="Left" MinWidth="120" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Value}"
                          IsVisible="{Binding IsChoice}" HorizontalAlignment="Left" MinWidth="200" />
                <CheckBox Grid.Column="1" IsChecked="{Binding Checked}" IsVisible="{Binding IsBool}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Value}" PasswordChar="•" IsVisible="{Binding IsSecret}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hint}" Classes="hint" Margin="0,3,0,0"
                           IsVisible="{Binding Hint, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20,14,20,18" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <StackPanel>
            <TextBlock x:Name="Header" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="Description" Classes="hint" Margin="0,4,0,0" IsVisible="False" />
            <TextBlock x:Name="OsWarning" TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="False"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
        </StackPanel>

        <!-- parameters -->
        <ScrollViewer Grid.Row="1" x:Name="ParamsBox" VerticalScrollBarVisibility="Auto" MaxHeight="280" Margin="0,14,0,0">
            <ItemsControl x:Name="ParamsList" ItemTemplate="{StaticResource ParamRow}" Margin="0,0,8,0" />
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,10,0,6">
            <TextBlock Text="{l:Tr ScriptRun.Output}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="ElapsedText" DockPanel.Dock="Right" Classes="hint" VerticalAlignment="Center" />
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="120" Height="4" MinWidth="0" Margin="12,0,0,0" Opacity="0" HorizontalAlignment="Left" />
        </DockPanel>
        <TextBox Grid.Row="3" x:Name="Output" IsReadOnly="True" Classes="mono"
                 TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" AcceptsReturn="True" />

        <!-- results reported by the script -->
        <Border Grid.Row="4" x:Name="ResultsBox" IsVisible="False" Margin="0,12,0,0" Padding="12,10" CornerRadius="6"
                BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock x:Name="ResultsHeader" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl x:Name="ResultsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6" ColumnDefinitions="170,*,Auto,Auto">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" Classes="mono" />
                                <Button Grid.Column="2" Content="{l:Tr Qr.Show}" Margin="6,0,0,0" Tag="{Binding}" Click="OnShowQr" IsVisible="{Binding HasQr}" />
                                <Button Grid.Column="3" Content="{l:Tr ScriptRun.Copy}" Margin="6,0,0,0" Tag="{Binding Value}" Click="OnCopyResult" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" x:Name="TerminalButton" Content="{l:Tr ScriptRun.InTerminal}" Click="OnRunInTerminal"
                    ToolTip.Tip="{l:Tr ScriptRun.InTerminalTip}" Padding="12,5" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RunButton" Content="{l:Tr ScriptRun.Run}" IsDefault="True" Click="OnRun" Classes="accent" MinWidth="120"
                        HorizontalContentAlignment="Center" />
                <Button x:Name="StopButton" Content="{l:Tr ScriptRun.Stop}" Click="OnStop" Classes="dialog" IsVisible="False" />
                <Button x:Name="CloseButton" Content="{l:Tr Common.Close}" IsCancel="True" Click="OnClose" Classes="dialog" />
            </StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,12,0" />
        </DockPanel>
    </Grid>
</Window>
