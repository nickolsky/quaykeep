<Window x:Class="Quaykeep.Views.FirewallPresetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Quaykeep.Localization"
        Title="{l:Tr Fw.PresetsTitle}" Width="640" Height="520" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20,14,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Fw.PresetsHint}" Margin="0,0,0,10" />
        <ListBox x:Name="PresetsList" Grid.Row="1" MouseDoubleClick="OnEdit">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Usage}" Style="{StaticResource Hint}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:Tr Fw.NewPreset}" Click="OnNew" Style="{StaticResource DialogButton}" />
                <Button Content="{l:Tr Fw.RenamePreset}" Click="OnRename" Style="{StaticResource DialogButton}" />
                <Button Content="{l:Tr Fw.DeletePreset}" Click="OnDelete" Style="{StaticResource DialogButton}" />
                <Button Content="{l:Tr Fw.EditPreset}" Click="OnEdit" Style="{DynamicResource AccentButtonStyle}" MinWidth="130" Margin="8,0,0,0" />
                <Button Content="{l:Tr Common.Close}" IsCancel="True" Style="{StaticResource DialogButton}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
