<Window x:Class="Quaykeep.Views.WhoisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Quaykeep.Localization"
        Width="820" Height="720" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True">
    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Header" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Note" Grid.Row="1" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="Collapsed" />
        <Border Grid.Row="2" Margin="0,10,0,10" Padding="14,10" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid x:Name="Fields">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </Border>
        <DockPanel Grid.Row="3">
            <TextBlock x:Name="RawTitle" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,4" />
            <TextBox x:Name="Raw" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </DockPanel>
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <ProgressBar x:Name="Busy" DockPanel.Dock="Left" IsIndeterminate="True" Width="100" Height="4" Visibility="Hidden" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PanelButton" Click="OnFindPanel" MinWidth="110" Margin="0,0,8,0" />
                <Button x:Name="RefreshButton" Content="{l:Tr Whois.Refresh}" Click="OnRefresh" MinWidth="110" Margin="0,0,8,0" />
                <Button Content="{l:Tr ScriptRun.Copy}" Click="OnCopy" MinWidth="100" Margin="0,0,8,0" />
                <Button Content="{l:Tr Common.Close}" IsCancel="True" IsDefault="True" MinWidth="100" Click="OnClose" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
