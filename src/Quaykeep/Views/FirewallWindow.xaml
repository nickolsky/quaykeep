<Window x:Class="Quaykeep.Views.FirewallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Quaykeep.Localization"
        Width="1180" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20,14,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="100" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Header" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="HintText" Grid.Row="1" Style="{StaticResource Hint}" Text="{l:Tr Fw.Hint}" Margin="0,6,0,8" />
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock x:Name="StateText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="HostFirewallText" Style="{StaticResource Hint}" Visibility="Collapsed" Margin="0,2,0,0" />
        </StackPanel>

        <!-- presets the server uses after its own rules -->
        <DockPanel x:Name="PresetsBar" Grid.Row="3" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="{l:Tr Fw.PresetsLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button DockPanel.Dock="Right" Content="{l:Tr Fw.ManagePresets}" Click="OnManagePresets" Padding="12,3" VerticalAlignment="Center" />
            <ItemsControl x:Name="PresetsList" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Label}" IsChecked="{Binding Checked, Mode=OneWay}" ToolTip="{Binding Tip}"
                                  Margin="0,0,16,0" MinWidth="0" Click="OnPresetClick" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <DataGrid Grid.Row="4" x:Name="RulesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False" MouseDoubleClick="OnRowDoubleClick"
                  SelectionChanged="OnSelectionChanged">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{l:Tr Fw.ColEnabled}" Width="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" IsEnabled="{Binding Own}" HorizontalAlignment="Center"
                                      MinWidth="0" Click="OnEnabledClick" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{l:Tr Fw.ColAction}" Binding="{Binding Action}" Width="180" />
                <DataGridTextColumn Header="{l:Tr Fw.ColTarget}" Binding="{Binding Target}" Width="150" />
                <DataGridTextColumn Header="{l:Tr Fw.ColSources}" Binding="{Binding Sources}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding SourcesTip}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{l:Tr Fw.ColComment}" Binding="{Binding Comment}" Width="150" />
                <DataGridTextColumn Header="{l:Tr Fw.ColFrom}" Binding="{Binding From}" Width="130" />
                <DataGridTextColumn Header="{l:Tr Fw.ColStatus}" Binding="{Binding Status}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="5" Margin="0,12,0,0" Padding="14,12" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr Fw.Action}" Margin="0,0,0,4" />
                        <ComboBox x:Name="ActionBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="{l:Tr Fw.Block}" />
                            <ComboBoxItem Content="{l:Tr Fw.AllowOnly}" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr Fw.Target}" Margin="0,0,0,4" />
                        <ComboBox x:Name="TargetBox" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnTargetChanged">
                            <ComboBoxItem Content="{l:Tr Fw.TargetPorts}" />
                            <ComboBoxItem Content="{l:Tr Fw.WholeServer}" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr Fw.Protocol}" Margin="0,0,0,4" />
                        <ComboBox x:Name="ProtoBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="tcp" />
                            <ComboBoxItem Content="udp" />
                            <ComboBoxItem Content="tcp+udp" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr Fw.Ports}" Margin="0,0,0,4" />
                        <TextBox x:Name="PortsBox" ToolTip="{l:Tr Fw.PortsHint}" />
                    </StackPanel>
                    <StackPanel Grid.Column="8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr Fw.Comment}" Margin="0,0,0,4" />
                        <TextBox x:Name="CommentBox" />
                    </StackPanel>
                </Grid>

                <DockPanel Grid.Row="1" Margin="0,12,0,4" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Text="{l:Tr Fw.Sources}" VerticalAlignment="Center" />
                    <Button x:Name="EveryoneButton" DockPanel.Dock="Right" Content="{l:Tr Fw.AddEveryone}" ToolTip="{l:Tr Fw.AddEveryoneTip}"
                            Padding="10,2" Margin="6,0,0,0" Click="OnAddEveryone" />
                    <Button x:Name="ServerButton" DockPanel.Dock="Right" Content="{l:Tr Fw.AddServer}" ToolTip="{l:Tr Fw.AddServerTip}"
                            Padding="10,2" Margin="6,0,0,0" Click="OnAddServer" />
                    <Button x:Name="ThisPcButton" DockPanel.Dock="Right" Content="{l:Tr Fw.AddThisPc}" Padding="10,2" Click="OnAddThisPc" />
                </DockPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBox x:Name="SourcesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="52" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas" ToolTip="{l:Tr Fw.SourcesHint}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Fw.SourcesHint}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                        <Button x:Name="CancelEditButton" Content="{l:Tr Fw.CancelEdit}" MinWidth="90" Height="52" Margin="0,0,8,0"
                                Click="OnCancelEdit" Visibility="Collapsed" />
                        <Button x:Name="AddButton" Content="{l:Tr Fw.Add}" MinWidth="130" Height="52" Click="OnAdd" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <TextBox x:Name="Log" Grid.Row="6" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"
                 FontSize="12" VerticalScrollBarVisibility="Auto" />

        <DockPanel Grid.Row="7" Margin="0,14,0,0">
            <ProgressBar x:Name="Busy" DockPanel.Dock="Left" IsIndeterminate="True" Width="120" Height="4" Visibility="Hidden" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TurnOffButton" Content="{l:Tr Fw.TurnOff}" Click="OnTurnOff" Style="{StaticResource DialogButton}" />
                <Button x:Name="CopyButton" Content="{l:Tr Fw.CopyTo}" Click="OnCopy" Style="{StaticResource DialogButton}" />
                <Button x:Name="RefreshButton" Content="{l:Tr Fw.Refresh}" Click="OnRefresh" Style="{StaticResource DialogButton}" />
                <Button x:Name="EditButton" Content="{l:Tr Fw.Edit}" Click="OnEdit" Style="{StaticResource DialogButton}" />
                <Button x:Name="DeleteButton" Content="{l:Tr Fw.Delete}" Click="OnDelete" Style="{StaticResource DialogButton}" />
                <Button x:Name="ApplyButton" Content="{l:Tr Fw.Apply}" Click="OnApply" Style="{DynamicResource AccentButtonStyle}" MinWidth="150" Margin="8,0,0,0" />
                <Button Content="{l:Tr Common.Close}" IsCancel="True" Click="OnClose" Style="{StaticResource DialogButton}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
