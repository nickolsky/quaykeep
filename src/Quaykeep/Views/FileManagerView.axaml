<UserControl x:Class="Quaykeep.Views.FileManagerView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Quaykeep.Localization"
             xmlns:v="using:Quaykeep.Views"
             xmlns:ic="using:FluentIcons.Avalonia">
    <UserControl.Styles>
        <Style Selector="Button.tool">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="TextBlock.failed">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
    </UserControl.Styles>
    <DockPanel Margin="0,10,0,0">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Classes="tool" Click="OnCopy" ToolTip.Tip="F5">
                <StackPanel Orientation="Horizontal">
                    <ic:SymbolIcon Symbol="Copy" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock x:Name="CopyText" Text="{l:Tr Files.CopyButton}" />
                </StackPanel>
            </Button>
            <Button Classes="tool" Click="OnMove" ToolTip.Tip="F6">
                <StackPanel Orientation="Horizontal">
                    <ic:SymbolIcon Symbol="ArrowRight" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="{l:Tr Files.MoveButton}" />
                </StackPanel>
            </Button>
            <Button Classes="tool" Click="OnNewFolder" ToolTip.Tip="F7">
                <StackPanel Orientation="Horizontal">
                    <ic:SymbolIcon Symbol="FolderAdd" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="{l:Tr Files.NewFolder}" />
                </StackPanel>
            </Button>
            <Button Classes="tool" Click="OnEdit" ToolTip.Tip="F4">
                <StackPanel Orientation="Horizontal">
                    <ic:SymbolIcon Symbol="Edit" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="{l:Tr Files.Edit}" />
                </StackPanel>
            </Button>
            <Button Classes="tool" Click="OnDelete" ToolTip.Tip="F8 / Delete">
                <StackPanel Orientation="Horizontal">
                    <ic:SymbolIcon Symbol="Delete" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="{l:Tr Files.Delete}" />
                </StackPanel>
            </Button>
            <Button Classes="tool" Click="OnTerminal">
                <StackPanel Orientation="Horizontal">
                    <ic:SymbolIcon Symbol="WindowConsole" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="{l:Tr Files.TerminalHere}" />
                </StackPanel>
            </Button>
            <CheckBox x:Name="HiddenBox" Content="{l:Tr Files.ShowHidden}" VerticalAlignment="Center" Margin="8,0,0,0"
                      IsCheckedChanged="OnHiddenChanged" Focusable="False" />
            <TextBlock Text="{l:Tr Files.KeysHint}" Classes="hint" VerticalAlignment="Center" Margin="16,0,0,0" />
        </WrapPanel>

        <!-- transfers -->
        <Border DockPanel.Dock="Bottom" x:Name="TransfersBox" IsVisible="False" Margin="0,8,0,0" Padding="0,6,0,0"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="{l:Tr Files.ClearDone}" Click="OnClearDone" Padding="10,3" Focusable="False" />
                    <TextBlock Text="{l:Tr Files.Transfers}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TransferList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Button DockPanel.Dock="Right" Content="{l:Tr Common.Cancel}" Command="{Binding CancelCommand}" Padding="10,2"
                                            Margin="8,0,0,0" Focusable="False" IsVisible="{Binding IsRunning}" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" Width="260" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTip.Tip="{Binding Title}" />
                                    <ProgressBar DockPanel.Dock="Left" Value="{Binding Percent, Mode=OneWay}" Width="160" Height="6" MinHeight="6"
                                                 Margin="8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding Text}" Classes="hint" Classes.failed="{Binding Failed}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>
            <v:FilePanelView x:Name="LeftPanel" Grid.Column="0" />
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False"
                          ResizeDirection="Columns" />
            <v:FilePanelView x:Name="RightPanel" Grid.Column="2" />
        </Grid>
    </DockPanel>
</UserControl>
