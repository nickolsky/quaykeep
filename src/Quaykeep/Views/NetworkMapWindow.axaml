<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Quaykeep.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="Quaykeep.Views.NetworkMapWindow"
        Title="{l:Tr Map.Title}" Width="1320" Height="840" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16,12,16,14" RowDefinitions="Auto,Auto,*,Auto,Auto">

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="PlanText" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.8" />
                <Button x:Name="DiscardButton" Content="{l:Tr Map.Discard}" Click="OnDiscard" Classes="toolbar" IsEnabled="False" />
                <Button x:Name="ApplyButton" Click="OnApply" Classes="accent" Padding="16,5" IsEnabled="False">
                    <TextBlock x:Name="ApplyText" Text="{l:Tr Map.Apply}" />
                </Button>
            </StackPanel>
            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Click="OnRefreshAll" Classes="toolbar" ToolTip.Tip="{l:Tr Map.RefreshTip}">
                    <StackPanel Orientation="Horizontal">
                        <ic:SymbolIcon Symbol="ArrowSync" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Map.Refresh}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="{l:Tr Map.AutoLayout}" Click="OnAutoLayout" Classes="toolbar" ToolTip.Tip="{l:Tr Map.AutoLayoutTip}" />
                <Button Content="{l:Tr Map.Fit}" Click="OnFit" Classes="toolbar" />
                <CheckBox x:Name="FirewallBox" Content="{l:Tr Map.ShowFirewall}" IsChecked="True" Click="OnOptionChanged" Margin="10,0,16,0"
                          VerticalAlignment="Center" ToolTip.Tip="{l:Tr Map.ShowFirewallTip}" />
                <CheckBox x:Name="OnlyLinkedBox" Content="{l:Tr Map.OnlyLinked}" Click="OnOptionChanged" VerticalAlignment="Center" />
            </WrapPanel>
        </DockPanel>
        <TextBlock Grid.Row="1" Classes="hint" Text="{l:Tr Map.Hint}" Margin="0,8,0,8" />

        <Grid Grid.Row="2" ColumnDefinitions="*,12,340">
            <Border CornerRadius="6" BorderThickness="1" ClipToBounds="True"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <LayoutTransformControl x:Name="ZoomHost" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Canvas x:Name="Board" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top"
                                PointerPressed="OnBoardDown" PointerMoved="OnBoardMove" PointerReleased="OnBoardUp" />
                    </LayoutTransformControl>
                </ScrollViewer>
            </Border>
            <TextBlock x:Name="EmptyText" Classes="hint" Text="{l:Tr Map.Empty}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" MaxWidth="460" TextAlignment="Center" />

            <Border Grid.Column="2" CornerRadius="6" BorderThickness="1" Padding="14,12"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Details" />
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBox x:Name="Log" Grid.Row="3" Margin="0,12,0,0" Height="96" IsReadOnly="True" TextWrapping="Wrap" Classes="mono"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" IsVisible="False" />

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <ProgressBar x:Name="Busy" DockPanel.Dock="Left" IsIndeterminate="True" Width="120" Height="4" MinWidth="0" Opacity="0" />
            <Button DockPanel.Dock="Right" Content="{l:Tr Common.Close}" IsCancel="True" Click="OnClose" Classes="dialog" />
            <WrapPanel x:Name="Legend" VerticalAlignment="Center" Margin="16,0,0,0" />
        </DockPanel>
    </Grid>
</Window>
