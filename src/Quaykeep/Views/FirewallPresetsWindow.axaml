<v:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Quaykeep.Views"
        xmlns:l="using:Quaykeep.Localization"
        x:Class="Quaykeep.Views.FirewallPresetsWindow"
        Title="{l:Tr Fw.PresetsTitle}" Width="640" Height="520" MinWidth="480" MinHeight="380">
    <Grid Margin="20,14,20,18" RowDefinitions="Auto,*,Auto">
        <TextBlock Classes="hint" Text="{l:Tr Fw.PresetsHint}" Margin="0,0,0,10" />
        <ListBox x:Name="PresetsList" Grid.Row="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Usage}" Classes="hint" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:Tr Fw.NewPreset}" Click="OnNew" Classes="dialog" />
                <Button Content="{l:Tr Fw.RenamePreset}" Click="OnRename" Classes="dialog" />
                <Button Content="{l:Tr Fw.DeletePreset}" Click="OnDelete" Classes="dialog" />
                <Button Content="{l:Tr Fw.EditPreset}" Click="OnEdit" Classes="accent" MinWidth="130" Margin="8,0,0,0" />
                <Button Content="{l:Tr Common.Close}" IsCancel="True" Classes="dialog" />
            </StackPanel>
        </DockPanel>
    </Grid>
</v:DialogWindow>
