<v:ToolWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Quaykeep.Views"
        xmlns:l="using:Quaykeep.Localization"
        x:Class="Quaykeep.Views.WhoisWindow"
        Width="820" Height="720" MinWidth="560" MinHeight="420" ShowInTaskbar="True">
    <Grid Margin="24,16,24,20" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <TextBlock x:Name="Header" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Note" Grid.Row="1" Classes="hint" Margin="0,4,0,0" IsVisible="False" />
        <Border Grid.Row="2" Margin="0,10,0,10" Padding="14,10" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid x:Name="Fields" ColumnDefinitions="Auto,*" />
        </Border>
        <DockPanel Grid.Row="3">
            <TextBlock x:Name="RawTitle" DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,4" />
            <TextBox x:Name="Raw" IsReadOnly="True" TextWrapping="NoWrap" Classes="mono" AcceptsReturn="True" VerticalContentAlignment="Top"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </DockPanel>
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <ProgressBar x:Name="Busy" DockPanel.Dock="Left" IsIndeterminate="True" Width="100" Height="4" MinWidth="0" Opacity="0" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PanelButton" Click="OnFindPanel" MinWidth="110" Margin="0,0,8,0" />
                <Button x:Name="RefreshButton" Content="{l:Tr Whois.Refresh}" Click="OnRefresh" MinWidth="110" Margin="0,0,8,0" />
                <Button Content="{l:Tr ScriptRun.Copy}" Click="OnCopy" MinWidth="100" Margin="0,0,8,0" />
                <Button Content="{l:Tr Common.Close}" IsCancel="True" IsDefault="True" MinWidth="100" Click="OnClose" />
            </StackPanel>
        </DockPanel>
    </Grid>
</v:ToolWindow>
