<v:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Quaykeep.Views"
        xmlns:l="using:Quaykeep.Localization"
        x:Class="Quaykeep.Views.PortMonitorWindow"
        Title="{l:Tr PortMon.Title}" Width="640" Height="520" MinWidth="520" MinHeight="380">
    <Grid Margin="20,14,20,18" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
        <TextBlock x:Name="Header" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Classes="hint" Text="{l:Tr PortMon.Hint}" Margin="0,6,0,10" />

        <DataGrid Grid.Row="2" x:Name="PortsGrid" AutoGenerateColumns="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{l:Tr PortMon.Monitor}" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Monitor}" IsEnabled="{Binding CanMonitor}"
                                      HorizontalAlignment="Center" MinWidth="0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{l:Tr PortMon.Port}" Binding="{Binding Port}" IsReadOnly="True" Width="70" />
                <DataGridTextColumn Header="{l:Tr PortMon.Name}" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="{l:Tr PortMon.Source}" Binding="{Binding Source}" IsReadOnly="True" Width="180" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,12,0,0" ColumnDefinitions="90,8,*,8,Auto">
            <TextBox x:Name="NewPort" ToolTip.Tip="{l:Tr PortMon.Port}" />
            <TextBox x:Name="NewName" Grid.Column="2" ToolTip.Tip="{l:Tr PortMon.Name}" />
            <Button Grid.Column="4" Content="{l:Tr PortMon.Add}" Click="OnAdd" MinWidth="100" />
        </Grid>

        <TextBlock x:Name="Error" Grid.Row="4" Foreground="#E0443E" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="False" />
        <DockPanel Grid.Row="5" Margin="0,16,0,0">
            <Button DockPanel.Dock="Left" x:Name="DetectButton" Content="{l:Tr PortMon.Detect}" Click="OnDetect" Padding="12,5" />
            <ProgressBar x:Name="Busy" DockPanel.Dock="Left" IsIndeterminate="True" Width="80" MinWidth="0" Height="4" Margin="12,0,0,0" Opacity="0" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:Tr Common.Save}" IsDefault="True" Click="OnSave" Classes="accent" MinWidth="110" />
                <Button Content="{l:Tr Common.Cancel}" IsCancel="True" Classes="dialog" />
            </StackPanel>
        </DockPanel>
    </Grid>
</v:DialogWindow>
