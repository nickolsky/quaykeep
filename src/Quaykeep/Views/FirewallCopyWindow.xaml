<Window x:Class="Quaykeep.Views.FirewallCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Quaykeep.Localization"
        Title="{l:Tr Fw.CopyTitle}" Width="520" Height="560" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20,14,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HintText" Style="{StaticResource Hint}" Margin="0,0,0,10" />
        <ListBox x:Name="ServersList">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding Checked}" Content="{Binding Label}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <RadioButton x:Name="AddRadio" Content="{l:Tr Fw.CopyAdd}" IsChecked="True" />
            <RadioButton x:Name="ReplaceRadio" Content="{l:Tr Fw.CopyReplace}" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{l:Tr Fw.CopyRun}" IsDefault="True" Click="OnOk" Style="{DynamicResource AccentButtonStyle}" MinWidth="150" />
            <Button Content="{l:Tr Common.Cancel}" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>
    </Grid>
</Window>
