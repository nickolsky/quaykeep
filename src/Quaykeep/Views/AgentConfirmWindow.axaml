<v:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Quaykeep.Views"
        xmlns:l="using:Quaykeep.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="Quaykeep.Views.AgentConfirmWindow"
        Width="520" SizeToContent="Height" CanResize="False" Topmost="True"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <StackPanel Margin="24,18,24,20">
        <StackPanel Orientation="Horizontal">
            <ic:SymbolIcon Symbol="Bot" FontSize="22" Margin="0,2,12,0" VerticalAlignment="Top" />
            <TextBlock x:Name="Header" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="430" />
        </StackPanel>
        <TextBlock x:Name="Body" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="13" />
        <TextBlock x:Name="Countdown" Classes="hint" Margin="0,12,0,0" />
        <WrapPanel HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="AllowButton" Content="{l:Tr Mcp.Allow}" Click="OnAllow" MinWidth="110" Margin="0,0,8,0" HorizontalContentAlignment="Center" />
            <Button Content="{l:Tr Mcp.Deny}" Click="OnDeny" IsCancel="True" IsDefault="True" MinWidth="110" Classes="accent" HorizontalContentAlignment="Center" />
        </WrapPanel>
    </StackPanel>
</v:DialogWindow>
