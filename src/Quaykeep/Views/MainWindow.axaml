<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Quaykeep.Views"
        xmlns:c="using:Quaykeep.Views.Controls"
        xmlns:l="using:Quaykeep.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="Quaykeep.Views.MainWindow"
        Title="Quaykeep" Width="1440" Height="740" MinWidth="780" MinHeight="440"
        WindowStartupLocation="CenterScreen">
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding AddServerCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding LockCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding RefreshAllCommand}" />
        <KeyBinding Gesture="Ctrl+M" Command="{Binding NetworkMapCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <!-- dynamic submenus (Install, Copy, Monitoring, AI agent access): MenuEntry items -->
        <Style Selector="MenuItem.entries MenuItem">
            <Setter Property="Header" Value="{Binding Header}" />
            <Setter Property="Command" Value="{Binding Command}" />
            <Setter Property="CommandParameter" Value="{Binding Parameter}" />
            <Setter Property="ItemsSource" Value="{Binding Children}" />
            <Setter Property="ToggleType" Value="{Binding Checked, Converter={x:Static v:MainWindow.CheckToggle}}" />
            <Setter Property="IsChecked" Value="{Binding Checked, Mode=OneWay}" />
            <Setter Property="FontWeight" Value="{Binding Bold, Converter={x:Static v:MainWindow.BoldWeight}}" />
        </Style>

        <!-- server tree rows: hover tint, selection tint and an accent bar on the left, like the WPF tree -->
        <Style Selector="c|TreeListView ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Margin="0,1">
                        <Border Name="HoverFill" CornerRadius="4" Background="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0" />
                        <Border Name="SelFill" CornerRadius="4" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                        <Border Name="Accent" Width="3" CornerRadius="1.5" Margin="0,4" HorizontalAlignment="Left"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" IsVisible="False" />
                        <ContentPresenter Name="PART_ContentPresenter" Padding="0,3" Background="Transparent"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="c|TreeListView ListBoxItem:pointerover /template/ Border#HoverFill">
            <Setter Property="Opacity" Value="0.07" />
        </Style>
        <Style Selector="c|TreeListView ListBoxItem:selected /template/ Border#SelFill">
            <Setter Property="Opacity" Value="0.25" />
        </Style>
        <Style Selector="c|TreeListView ListBoxItem:selected /template/ Border#Accent">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- the expander arrow: hidden (keeping its space) on rows without children -->
        <Style Selector="ToggleButton.treeExpander">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="Transparent" CornerRadius="3">
                        <ic:SymbolIcon Name="Glyph" Symbol="ChevronRight" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.treeExpander:checked /template/ ic|SymbolIcon#Glyph">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
        <Style Selector="ToggleButton.treeExpander:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.treeExpander.leaf">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="TextBlock.cell.muted">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="TextBlock.bold">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.warn">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </Style>
        <Style Selector="TextBlock.bad">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource ControlStrongFillColorDisabledBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- headers only: the pages live in PageHost (see below) -->
        <Style Selector="TabControl.strip">
            <Setter Property="Template">
                <ControlTemplate>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="10,0,0,-1" ZIndex="1">
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.topRight">
            <Setter Property="Padding" Value="12,4" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- menu on the left, Lock / Exit on the right of the same row -->
        <DockPanel DockPanel.Dock="Top" Margin="0,2,12,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Classes="topRight" Command="{Binding LockCommand}" ToolTip.Tip="Ctrl+L" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ic:SymbolIcon Symbol="LockClosed" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Main.Lock}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="topRight" Command="{Binding ExitCommand}" ToolTip.Tip="{l:Tr Main.ExitTip}">
                    <StackPanel Orientation="Horizontal">
                        <ic:SymbolIcon Symbol="Power" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Menu.Exit}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Menu Padding="8,2,8,0" Background="Transparent" VerticalAlignment="Center">
                <MenuItem Header="{l:Tr Menu.File}">
                    <MenuItem Header="{l:Tr Menu.NewServer}" Command="{Binding AddServerCommand}" InputGesture="Ctrl+N" />
                    <Separator />
                    <MenuItem Header="{l:Tr Menu.BackupNow}" Command="{Binding BackupNowCommand}" />
                    <MenuItem Header="{l:Tr Restore.Button}" Command="{Binding RestoreBackupCommand}" />
                    <MenuItem Header="{l:Tr Menu.OpenDataFolder}" Command="{Binding OpenDataFolderCommand}" />
                    <Separator />
                    <MenuItem Header="{l:Tr Menu.Lock}" Command="{Binding LockCommand}" InputGesture="Ctrl+L" />
                    <MenuItem Header="{l:Tr Menu.Exit}" Command="{Binding ExitCommand}" />
                </MenuItem>
                <MenuItem Header="{l:Tr Menu.View}">
                    <MenuItem Header="{l:Tr Menu.ExpandAll}" Command="{Binding ExpandAllCommand}" />
                    <MenuItem Header="{l:Tr Menu.CollapseAll}" Command="{Binding CollapseAllCommand}" />
                    <MenuItem Header="{l:Tr Menu.NetworkMap}" Command="{Binding NetworkMapCommand}" InputGesture="Ctrl+M" />
                    <MenuItem Header="{l:Tr Menu.AllTunnels}" Command="{Binding AllTunnelsCommand}" />
                    <Separator />
                    <MenuItem Header="{l:Tr Menu.RefreshAll}" Command="{Binding RefreshAllCommand}" InputGesture="F5" />
                </MenuItem>
                <MenuItem Header="{l:Tr Menu.Language}">
                    <MenuItem Header="{l:Tr Lang.System}" ToggleType="Radio" IsChecked="{Binding IsLangSystem, Mode=OneWay}"
                              Command="{Binding SetLanguageCommand}" CommandParameter="system" />
                    <MenuItem Header="Русский" ToggleType="Radio" IsChecked="{Binding IsLangRu, Mode=OneWay}"
                              Command="{Binding SetLanguageCommand}" CommandParameter="ru" />
                    <MenuItem Header="English" ToggleType="Radio" IsChecked="{Binding IsLangEn, Mode=OneWay}"
                              Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                </MenuItem>
                <MenuItem Header="{l:Tr Menu.Help}">
                    <MenuItem Header="{l:Tr Menu.About}" Command="{Binding AboutCommand}" />
                </MenuItem>
            </Menu>
        </DockPanel>

        <Grid Margin="12,6,12,8" RowDefinitions="Auto,*,Auto">
            <!-- The tab strip only shows the headers: every page (servers, keys, settings, terminals, files, editors)
                 stays in PageHost below and is only hidden, because a TabControl detaches unselected content and
                 the terminal's native web view would be destroyed and reloaded. The pages are moved there on load. -->
            <c:AppTabControl x:Name="Tabs" Classes="cards strip" ZIndex="1" SelectedIndex="{Binding SelectedTab}">
                <!-- ================= SERVERS ================= -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="Server" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{l:Tr Tab.Servers}" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid RowDefinitions="Auto,*">
                        <DockPanel Margin="0,0,0,10">
                            <TextBox DockPanel.Dock="Right" Width="240" x:Name="SearchBox" VerticalAlignment="Center"
                                     Text="{Binding SearchText}" ToolTip.Tip="{l:Tr Main.SearchTip}" />
                            <TextBlock DockPanel.Dock="Right" Text="{l:Tr Main.Search}" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" />
                            <WrapPanel>
                                <Button Command="{Binding ConnectCommand}" Classes="accent" Margin="0,0,6,0" Padding="14,5">
                                    <TextBlock><Run Text="▶  " /><Run Text="{l:Tr Main.Connect}" /></TextBlock>
                                </Button>
                                <Button Command="{Binding FilesCommand}" Classes="toolbar" ToolTip.Tip="{l:Tr Main.FilesTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <ic:SymbolIcon Symbol="Folder" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{l:Tr Main.Files}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RebootCommand}" Classes="toolbar" ToolTip.Tip="{l:Tr Main.RebootTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <ic:SymbolIcon Symbol="ArrowClockwise" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{l:Tr Main.Reboot}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Content="{l:Tr Main.AddServer}" Command="{Binding AddServerCommand}" Classes="toolbar" ToolTip.Tip="Ctrl+N" />
                                <Button Content="{l:Tr Main.Edit}" Command="{Binding EditServerCommand}" Classes="toolbar" />
                                <Button Command="{Binding SetupKeyCommand}" Classes="toolbar" ToolTip.Tip="{l:Tr Main.SetupKeyTip}">
                                    <TextBlock><Run Text="🔑 " /><Run Text="{l:Tr Main.SetupKey}" /></TextBlock>
                                </Button>
                                <Button Content="{l:Tr Main.Test}" Command="{Binding TestCommand}" Classes="toolbar" />
                                <Button Content="{l:Tr Main.PortForwards}" Command="{Binding PortForwardsCommand}" Classes="toolbar" />
                                <Button Content="{l:Tr Main.Firewall}" Command="{Binding FirewallCommand}" Classes="toolbar" />
                                <Button Content="{l:Tr Main.NetworkMap}" Command="{Binding NetworkMapCommand}" Classes="toolbar" ToolTip.Tip="{l:Tr Main.NetworkMapTip}" />
                                <Button Command="{Binding RefreshAllCommand}" Classes="toolbar" ToolTip.Tip="{l:Tr Main.RefreshAllTip}">
                                    <ic:SymbolIcon Symbol="ArrowSync" FontSize="14" />
                                </Button>
                            </WrapPanel>
                        </DockPanel>

                        <c:TreeListView Grid.Row="1" x:Name="ServersTree" ItemsSource="{Binding Roots}">
                            <c:TreeListView.Columns>
                                <c:TreeListColumn Header="{l:Tr Col.Name}" Width="230">
                                    <c:TreeListColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" ToolTip.Tip="{Binding Tip}" Background="Transparent">
                                                <ToggleButton Classes="treeExpander" Classes.leaf="{Binding !CanExpand}" IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
                                                <c:StatusDot Dot="{Binding Dot}" ToolTip.Tip="{Binding Tip}" />
                                                <ic:SymbolIcon Symbol="{Binding Icon, TargetNullValue=Info}" FontSize="14" Margin="0,0,7,0"
                                                               VerticalAlignment="Center" Opacity="0.75"
                                                               IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <TextBlock Text="{Binding Title}" Classes="cell" Classes.muted="{Binding IsMuted}" Classes.bold="{Binding IsBold}" />
                                                <Border Margin="6,0,0,0" Padding="6,0" CornerRadius="8" VerticalAlignment="Center"
                                                        Background="{DynamicResource ControlStrongFillColorDisabledBrush}"
                                                        IsVisible="{Binding Badge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Text="{Binding Badge}" FontSize="11" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </c:TreeListColumn.CellTemplate>
                                </c:TreeListColumn>
                                <c:TreeListColumn Header="{l:Tr Col.Address}" Width="160">
                                    <c:TreeListColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Address}" Classes="cell" Classes.muted="{Binding IsMuted}" />
                                        </DataTemplate>
                                    </c:TreeListColumn.CellTemplate>
                                </c:TreeListColumn>
                                <c:TreeListColumn Header="{l:Tr Col.Os}" Width="125">
                                    <c:TreeListColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Os}" ToolTip.Tip="{Binding OsTip}" Classes="cell" Classes.muted="{Binding IsMuted}" />
                                        </DataTemplate>
                                    </c:TreeListColumn.CellTemplate>
                                </c:TreeListColumn>
                                <c:TreeListColumn Header="{l:Tr Col.Cpu}" Width="95">
                                    <c:TreeListColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" ToolTip.Tip="{Binding UsageTip}" Background="Transparent"
                                                        IsVisible="{Binding CpuPercent, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <c:UsageBar Value="{Binding CpuPercent}" Level="{Binding CpuLevel}" />
                                                <TextBlock Text="{Binding Cpu}" Classes="cell" Classes.muted="{Binding IsMuted}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </c:TreeListColumn.CellTemplate>
                                </c:TreeListColumn>
                                <c:TreeListColumn Header="{l:Tr Col.Mem}" Width="140">
                                    <c:TreeListColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" ToolTip.Tip="{Binding UsageTip}" Background="Transparent"
                                                        IsVisible="{Binding MemPercent, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <c:UsageBar Value="{Binding MemPercent}" Level="{Binding MemLevel}" />
                                                <TextBlock Text="{Binding Mem}" Classes="cell" Classes.muted="{Binding IsMuted}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </c:TreeListColumn.CellTemplate>
                                </c:TreeListColumn>
                                <c:TreeListColumn Header="{l:Tr Col.Disk}" Width="150">
                                    <c:TreeListColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" ToolTip.Tip="{Binding UsageTip}" Background="Transparent"
                                                        IsVisible="{Binding DiskPercent, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <c:UsageBar Value="{Binding DiskPercent}" Level="{Binding DiskLevel}" />
                                                <TextBlock Text="{Binding Disk}" Classes="cell" Classes.muted="{Binding IsMuted}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </c:TreeListColumn.CellTemplate>
                                </c:TreeListColumn>
                                <c:TreeListColumn Header="{l:Tr Col.Uptime}" Width="170">
                                    <c:TreeListColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Uptime}" ToolTip.Tip="{Binding UptimeTip}" Classes="cell" Classes.muted="{Binding IsMuted}"
                                                       Classes.warn="{Binding UptimeLevel, Converter={x:Static v:Conv.Equal}, ConverterParameter=warn}"
                                                       Classes.bad="{Binding UptimeLevel, Converter={x:Static v:Conv.Equal}, ConverterParameter=bad}" />
                                        </DataTemplate>
                                    </c:TreeListColumn.CellTemplate>
                                </c:TreeListColumn>
                                <c:TreeListColumn Header="{l:Tr Col.Ports}" Width="130">
                                    <c:TreeListColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding PortChips}" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Classes="chip" Padding="5,1,7,1" Margin="0,0,4,0" ToolTip.Tip="{Binding Tip}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <c:StatusDot Dot="{Binding Dot}" Width="7" Height="7" Margin="0,0,4,0" />
                                                                <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </c:TreeListColumn.CellTemplate>
                                </c:TreeListColumn>
                                <c:TreeListColumn Header="{l:Tr Col.Region}" Width="140">
                                    <c:TreeListColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" ToolTip.Tip="{Binding RegionTip}" Background="Transparent">
                                                <Border CornerRadius="3" Padding="4,0" Margin="0,0,6,0" VerticalAlignment="Center"
                                                        Background="{DynamicResource ControlStrongFillColorDisabledBrush}"
                                                        IsVisible="{Binding CountryCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Text="{Binding CountryCode}" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding Region}" Classes="cell" Classes.muted="{Binding IsMuted}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </c:TreeListColumn.CellTemplate>
                                </c:TreeListColumn>
                                <c:TreeListColumn Header="{l:Tr Col.Hoster}" Width="170">
                                    <c:TreeListColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Hoster}" ToolTip.Tip="{Binding HosterTip}" Classes="cell" Classes.muted="{Binding IsMuted}" />
                                        </DataTemplate>
                                    </c:TreeListColumn.CellTemplate>
                                </c:TreeListColumn>
                                <c:TreeListColumn Header="{l:Tr Col.LastConnected}" Width="120">
                                    <c:TreeListColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LastConnected}" Classes="cell" Classes.muted="{Binding IsMuted}" />
                                        </DataTemplate>
                                    </c:TreeListColumn.CellTemplate>
                                </c:TreeListColumn>
                                <c:TreeListColumn Header="{l:Tr Col.Notes}" Width="150">
                                    <c:TreeListColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Notes}" ToolTip.Tip="{Binding Notes}" Classes="cell" Classes.muted="{Binding IsMuted}" />
                                        </DataTemplate>
                                    </c:TreeListColumn.CellTemplate>
                                </c:TreeListColumn>
                            </c:TreeListView.Columns>
                            <c:TreeListView.ContextMenu>
                                <ContextMenu x:Name="TreeMenu">
                                    <MenuItem Header="{l:Tr Ctx.Connect}" Command="{Binding ConnectCommand}" FontWeight="SemiBold"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{l:Tr Ctx.Files}" Command="{Binding FilesCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{l:Tr Ctx.Edit}" Command="{Binding EditServerCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{l:Tr Ctx.AwsSignIn}" Command="{Binding AwsSignInCommand}" ToolTip.Tip="{l:Tr Ctx.AwsSignInTip}"
                                              IsVisible="{Binding SelectedIsSsm}" />
                                    <MenuItem Header="{l:Tr Ctx.Copy}" Classes="entries" ItemsSource="{Binding CopyItems}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{l:Tr Ctx.Duplicate}" Command="{Binding DuplicateServerCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <Separator IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{l:Tr Ctx.Install}" Classes="entries" ItemsSource="{Binding InstallItems}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{l:Tr Ctx.InstallDocker}" Command="{Binding InstallDockerCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{Binding ForwardPeerHeader}" Command="{Binding GoToForwardPeerCommand}" FontWeight="SemiBold"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=forward}" />
                                    <MenuItem Header="{l:Tr Ctx.PortForwards}" Command="{Binding PortForwardsCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.OneOf}, ConverterParameter=server|forward}" />
                                    <MenuItem Header="{l:Tr Ctx.Tunnels}" Command="{Binding TunnelsCommand}" ToolTip.Tip="{l:Tr Ctx.TunnelsTip}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{l:Tr Ctx.Firewall}" Command="{Binding FirewallCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.OneOf}, ConverterParameter=server|firewall}" />
                                    <MenuItem Header="{l:Tr Ctx.NetworkMap}" Command="{Binding NetworkMapCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.OneOf}, ConverterParameter=server|forward}" />
                                    <MenuItem Header="{l:Tr Ctx.MonitorPort}" Command="{Binding TogglePortCommand}" FontWeight="SemiBold"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=port-off}" />
                                    <MenuItem Header="{l:Tr Ctx.UnmonitorPort}" Command="{Binding TogglePortCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=port-on}" />
                                    <MenuItem Header="{l:Tr Ctx.PortMonitor}" Command="{Binding PortMonitorCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.OneOf}, ConverterParameter=server|port-on|port-off}" />
                                    <MenuItem Header="{l:Tr Ctx.SetupKey}" Command="{Binding SetupKeyCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{l:Tr Ctx.McpAccess}" Classes="entries" ItemsSource="{Binding McpItems}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <Separator IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{l:Tr Ctx.Ping}" Command="{Binding PingCommand}" ToolTip.Tip="{l:Tr Ctx.PingTip}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{l:Tr Ctx.Trace}" Command="{Binding TraceCommand}" ToolTip.Tip="{l:Tr Ctx.TraceTip}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{l:Tr Ctx.Whois}" Command="{Binding WhoisCommand}" ToolTip.Tip="{l:Tr Ctx.WhoisTip}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{Binding FindPanelHeader}" Command="{Binding FindPanelCommand}" ToolTip.Tip="{l:Tr Ctx.FindPanelTip}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{l:Tr Ctx.CheckNow}" Command="{Binding CheckNowCommand}" ToolTip.Tip="{l:Tr Ctx.CheckNowTip}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{l:Tr Ctx.Test}" Command="{Binding TestCommand}" ToolTip.Tip="{l:Tr Ctx.TestTip}" ToolTip.ShowOnDisabled="True"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{l:Tr Ctx.RefreshInfo}" Command="{Binding RefreshInfoCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{l:Tr Ctx.Monitoring}" Classes="entries" ItemsSource="{Binding MonitorItems}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{l:Tr Ctx.UptimeHistory}" Command="{Binding UptimeHistoryCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <Separator IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{l:Tr Ctx.Reboot}" Command="{Binding RebootCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />
                                    <MenuItem Header="{l:Tr Ctx.Delete}" Command="{Binding DeleteServerCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=server}" />

                                    <MenuItem Header="{l:Tr Ctx.ContainerLogs}" Command="{Binding ContainerLogsCommand}" FontWeight="SemiBold"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=container}" />
                                    <Separator IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=container}" />
                                    <MenuItem Header="{l:Tr Ctx.ContainerStart}" Command="{Binding ContainerStartCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=container}" />
                                    <MenuItem Header="{l:Tr Ctx.ContainerStop}" Command="{Binding ContainerStopCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=container}" />
                                    <MenuItem Header="{l:Tr Ctx.ContainerRestart}" Command="{Binding ContainerRestartCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=container}" />
                                    <MenuItem Header="{l:Tr Ctx.ContainerAutostart}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=container}">
                                        <MenuItem Header="{l:Tr Container.PolicyUnlessStopped}" ToggleType="Radio" IsChecked="{Binding IsRestartUnlessStopped, Mode=OneWay}"
                                                  Command="{Binding ContainerAutostartCommand}" CommandParameter="unless-stopped" />
                                        <MenuItem Header="{l:Tr Container.PolicyAlways}" ToggleType="Radio" IsChecked="{Binding IsRestartAlways, Mode=OneWay}"
                                                  Command="{Binding ContainerAutostartCommand}" CommandParameter="always" />
                                        <MenuItem Header="{l:Tr Container.PolicyOnFailure}" ToggleType="Radio" IsChecked="{Binding IsRestartOnFailure, Mode=OneWay}"
                                                  Command="{Binding ContainerAutostartCommand}" CommandParameter="on-failure" />
                                        <MenuItem Header="{l:Tr Container.PolicyNo}" ToggleType="Radio" IsChecked="{Binding IsRestartNo, Mode=OneWay}"
                                                  Command="{Binding ContainerAutostartCommand}" CommandParameter="no" />
                                    </MenuItem>
                                    <Separator IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=container}" />
                                    <MenuItem Header="{l:Tr Ctx.ContainerRemove}" Command="{Binding ContainerRemoveCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=container}" />

                                    <MenuItem Header="{l:Tr Ctx.ServiceStatus}" Command="{Binding ServiceStatusCommand}" FontWeight="SemiBold"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=service}" />
                                    <MenuItem Header="{l:Tr Ctx.ServiceLogs}" Command="{Binding ServiceLogsCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=service}" />
                                    <Separator IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=service}" />
                                    <MenuItem Header="{l:Tr Ctx.ContainerStart}" Command="{Binding ServiceStartCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=service}" />
                                    <MenuItem Header="{l:Tr Ctx.ContainerStop}" Command="{Binding ServiceStopCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=service}" />
                                    <MenuItem Header="{l:Tr Ctx.ServiceRestart}" Command="{Binding ServiceRestartCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=service}" />
                                    <MenuItem Header="{l:Tr Ctx.ContainerAutostart}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=service}">
                                        <MenuItem Header="{l:Tr Service.AutostartOn}" ToggleType="Radio" IsChecked="{Binding IsServiceAutostart, Mode=OneWay}"
                                                  Command="{Binding ServiceEnableCommand}" />
                                        <MenuItem Header="{l:Tr Service.AutostartOff}" ToggleType="Radio" IsChecked="{Binding IsServiceNoAutostart, Mode=OneWay}"
                                                  Command="{Binding ServiceDisableCommand}" />
                                    </MenuItem>

                                    <MenuItem Header="{l:Tr Cron.CopyLine}" Command="{Binding CronCopyCommand}" FontWeight="SemiBold"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=cron}" />
                                    <MenuItem Header="{l:Tr Cron.OpenFile}" Command="{Binding CronOpenFileCommand}"
                                              IsVisible="{Binding SelectedCronKind, Converter={x:Static v:Conv.OneOf}, ConverterParameter=File|Periodic}" />
                                    <MenuItem Header="{l:Tr Cron.EditCrontab}" Command="{Binding CronEditCommand}"
                                              IsVisible="{Binding SelectedCronKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=Crontab}" />
                                    <MenuItem Header="{l:Tr Cron.TimerStatus}" Command="{Binding CronTimerStatusCommand}"
                                              IsVisible="{Binding SelectedCronKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=Timer}" />
                                    <MenuItem Header="{l:Tr Cron.TimerLogs}" Command="{Binding CronTimerLogsCommand}"
                                              IsVisible="{Binding SelectedCronKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=Timer}" />

                                    <MenuItem Header="{l:Tr Ctx.CopyValue}" Command="{Binding CopyAttributeCommand}" FontWeight="SemiBold"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=attribute}" />
                                    <MenuItem Header="{l:Tr Qr.ShowMenu}" Command="{Binding ShowAttributeQrCommand}"
                                              IsVisible="{Binding SelectedAttributeHasQr}" />
                                    <MenuItem Header="{l:Tr Ctx.DeleteAttribute}" Command="{Binding DeleteAttributeCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.Equal}, ConverterParameter=attribute}" />

                                    <MenuItem Header="{l:Tr Ctx.AddServer}" Command="{Binding AddServerCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.OneOf}, ConverterParameter=group|}" />
                                    <MenuItem Header="{l:Tr Ctx.GroupFirewall}" Command="{Binding GroupFirewallCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.OneOf}, ConverterParameter=group|}" />
                                    <MenuItem Header="{l:Tr Menu.ExpandAll}" Command="{Binding ExpandAllCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.OneOf}, ConverterParameter=group|}" />
                                    <MenuItem Header="{l:Tr Menu.CollapseAll}" Command="{Binding CollapseAllCommand}"
                                              IsVisible="{Binding SelectionKind, Converter={x:Static v:Conv.OneOf}, ConverterParameter=group|}" />
                                </ContextMenu>
                            </c:TreeListView.ContextMenu>
                        </c:TreeListView>
                    </Grid>
                </TabItem>

                <!-- ================= KEYS ================= -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="Key" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{l:Tr Tab.Keys}" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid RowDefinitions="Auto,*">
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="{l:Tr Keys.Generate}" Command="{Binding GenerateKeyCommand}" Classes="accent" Margin="0,0,6,0" Padding="14,5" />
                            <Button Content="{l:Tr Keys.Import}" Command="{Binding ImportKeyCommand}" Classes="toolbar" />
                            <Button Content="{l:Tr Keys.CopyPublic}" Command="{Binding CopyPublicKeyCommand}" Classes="toolbar" />
                            <Button Content="{l:Tr Keys.ExportPrivate}" Command="{Binding ExportPrivateKeyCommand}" Classes="toolbar" />
                            <Button Content="{l:Tr Keys.Rename}" Command="{Binding RenameKeyCommand}" Classes="toolbar" />
                            <Button Content="{l:Tr Keys.Delete}" Command="{Binding DeleteKeyCommand}" Classes="toolbar" />
                        </WrapPanel>
                        <DataGrid Grid.Row="1" x:Name="KeysGrid" ItemsSource="{Binding Keys}" SelectedItem="{Binding SelectedKey}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserResizeColumns="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:Tr Col.Name}" Binding="{Binding Name}" Width="190" MinWidth="80" />
                                <DataGridTextColumn Header="{l:Tr Keys.Type}" Binding="{Binding Type}" Width="80" MinWidth="60" />
                                <DataGridTextColumn Header="{l:Tr Keys.Fingerprint}" Binding="{Binding Fingerprint}" Width="330" MinWidth="120" />
                                <DataGridTextColumn Header="{l:Tr Keys.Comment}" Binding="{Binding Comment}" Width="170" MinWidth="80" />
                                <DataGridTextColumn Header="{l:Tr Keys.Created}" Binding="{Binding Created}" Width="95" MinWidth="70" />
                                <DataGridTextColumn Header="{l:Tr Keys.Servers}" Binding="{Binding UsedBy}" Width="*" MinWidth="120" />
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:Tr Keys.CopyPublic}" Command="{Binding CopyPublicKeyCommand}" />
                                    <MenuItem Header="{l:Tr Keys.ExportPrivate}" Command="{Binding ExportPrivateKeyCommand}" />
                                    <MenuItem Header="{l:Tr Keys.Rename}" Command="{Binding RenameKeyCommand}" />
                                    <Separator />
                                    <MenuItem Header="{l:Tr Keys.Delete}" Command="{Binding DeleteKeyCommand}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ================= SETTINGS ================= -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="Settings" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{l:Tr Tab.Settings}" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,0,16,16" MaxWidth="1400" HorizontalAlignment="Left" DataContext="{Binding Settings}">
                            <TextBlock Classes="sectionHeader" Text="{l:Tr Settings.Interface}" Margin="0,4,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{l:Tr Settings.Language}" VerticalAlignment="Center" />
                                <ComboBox SelectedIndex="{Binding LanguageIndex}" Width="220" Margin="10,0,0,0">
                                    <ComboBoxItem Content="{l:Tr Lang.System}" />
                                    <ComboBoxItem Content="Русский" />
                                    <ComboBoxItem Content="English" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="HotkeyRow" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{l:Tr Hotkey.Label}" VerticalAlignment="Center" />
                                <TextBox x:Name="HotkeyBox" Text="{Binding HotkeyText, Mode=OneWay}" Width="200" Margin="10,0,0,0" IsReadOnly="True"
                                         ToolTip.Tip="{l:Tr Hotkey.Tip}" />
                                <Button Content="{l:Tr Hotkey.Default}" Click="OnHotkeyDefault" Margin="8,0,0,0" Padding="10,4" />
                                <Button Content="{l:Tr Hotkey.Clear}" Click="OnHotkeyClear" Margin="6,0,0,0" Padding="10,4" />
                                <TextBlock Text="{Binding HotkeyStatus}" Classes="hint" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="HotkeyUnsupported" Classes="hint" Margin="0,10,0,0" IsVisible="False" />

                            <TextBlock Classes="sectionHeader" Text="{l:Tr Settings.Startup}" />
                            <CheckBox Content="{l:Tr Settings.AutostartBox}" IsChecked="{Binding Autostart}" />
                            <CheckBox Content="{l:Tr Settings.CloseToTray}" IsChecked="{Binding CloseToTray}" Margin="0,8,0,0" />

                            <TextBlock Classes="sectionHeader" Text="{l:Tr Settings.Security}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{l:Tr Settings.AutoLock}" VerticalAlignment="Center" />
                                <TextBox Width="70" Margin="10,0,0,0" Text="{Binding AutoLockMinutes, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <CheckBox Content="{l:Tr Settings.LockOnWinL}" IsChecked="{Binding LockOnWindowsLock}" Margin="0,8,0,0" />
                            <CheckBox Content="{l:Tr Settings.UnlockOnAgent}" IsChecked="{Binding UnlockOnAgentRequest}" Margin="0,8,0,0" />
                            <Button Content="{l:Tr Settings.ChangePassword}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Command="{Binding $parent[Window].DataContext.ChangePasswordCommand}" />

                            <TextBlock Classes="sectionHeader" Text="{l:Tr Settings.Monitoring}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{l:Tr Settings.MonitorInterval}" VerticalAlignment="Center" />
                                <TextBox Width="70" Margin="10,0,0,0" Text="{Binding MonitorIntervalMinutes, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <TextBlock Classes="hint" Text="{l:Tr Settings.MonitorHint}" Margin="0,4,0,0" />
                            <CheckBox Content="{l:Tr Settings.CollectMetrics}" IsChecked="{Binding CollectMetrics}" Margin="0,8,0,0" />
                            <CheckBox Content="{l:Tr Settings.NotifyDown}" IsChecked="{Binding NotifyOnServerDown}" Margin="0,8,0,0" />
                            <CheckBox Content="{l:Tr Settings.AutoInventory}" IsChecked="{Binding AutoInventory}" Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{l:Tr Settings.GeoIp}" VerticalAlignment="Center" />
                                <ComboBox SelectedIndex="{Binding GeoLookupIndex}" Width="300" Margin="10,0,0,0">
                                    <ComboBoxItem Content="{l:Tr Settings.GeoIpWhoIs}" />
                                    <ComboBoxItem Content="{l:Tr Settings.GeoIpApi}" />
                                    <ComboBoxItem Content="{l:Tr Settings.GeoOff}" />
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Classes="hint" Text="{l:Tr Settings.GeoIpHint}" Margin="0,4,0,0" />

                            <TextBlock Classes="sectionHeader" Text="{l:Tr Settings.Scripts}" />
                            <TextBlock Classes="hint" Text="{l:Tr Settings.ScriptsHint}" />
                            <Grid Margin="0,8,0,0" Height="520" ColumnDefinitions="340,12,*">
                                <DockPanel>
                                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                        <Button Content="{l:Tr Scripts.Add}" Command="{Binding AddScriptCommand}" Classes="toolbar" Padding="10,4" />
                                        <Button Content="{l:Tr Scripts.AddCompose}" Command="{Binding AddComposeCommand}" Classes="toolbar" Padding="10,4"
                                                ToolTip.Tip="{l:Tr Scripts.AddComposeTip}" />
                                        <Button Content="{l:Tr Scripts.Duplicate}" Command="{Binding DuplicateScriptCommand}" Classes="toolbar" Padding="10,4" />
                                        <Button Content="{l:Tr Scripts.Delete}" Command="{Binding DeleteScriptCommand}" Classes="toolbar" Padding="10,4" />
                                        <Button Content="{l:Tr Scripts.RestoreBuiltins}" Command="{Binding RestoreBuiltinsCommand}" Classes="toolbar"
                                                Padding="10,4" Margin="0,6,0,0" ToolTip.Tip="{l:Tr Scripts.RestoreBuiltinsTip}" />
                                    </WrapPanel>
                                    <ListBox ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border CornerRadius="3" Padding="4,0" Margin="0,1,6,0" VerticalAlignment="Center"
                                                                Background="{DynamicResource ControlStrongFillColorDisabledBrush}"
                                                                IsVisible="{Binding BuiltinId, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                            <TextBlock Text="{l:Tr Scripts.BuiltinTag}" FontSize="10" />
                                                        </Border>
                                                        <TextBlock Text="{Binding OsFilter}" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <DockPanel Grid.Column="2" IsEnabled="{Binding HasScript}">
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,10,*">
                                        <StackPanel>
                                            <TextBlock Classes="fieldLabel" Text="{l:Tr Scripts.Name}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding ScriptName}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Classes="fieldLabel" Text="{l:Tr Scripts.OsFilter}" Margin="0,0,0,4" />
                                            <!-- multi-select drop-down of os-release IDs -->
                                            <DropDownButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTip.Tip="{Binding ScriptOsSummary}">
                                                <TextBlock Text="{Binding ScriptOsSummary}" TextTrimming="CharacterEllipsis" />
                                                <DropDownButton.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                                        <StackPanel MinWidth="300">
                                                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl ItemsSource="{Binding OsOptions}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,1" ToolTip.Tip="{Binding Id}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                            <DockPanel Margin="0,8,0,0">
                                                                <Button DockPanel.Dock="Right" Content="{l:Tr Scripts.AddOs}" Command="{Binding AddOsCommand}" Margin="6,0,0,0" />
                                                                <TextBox Text="{Binding NewOsId}" ToolTip.Tip="{l:Tr Scripts.OsFilterTip}" />
                                                            </DockPanel>
                                                            <TextBlock Classes="hint" Text="{l:Tr Scripts.OsHint}" Margin="0,6,0,0" MaxWidth="360" HorizontalAlignment="Left" />
                                                        </StackPanel>
                                                    </Flyout>
                                                </DropDownButton.Flyout>
                                            </DropDownButton>
                                        </StackPanel>
                                    </Grid>
                                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Content="{l:Tr Scripts.Save}" Command="{Binding SaveScriptCommand}"
                                                Classes="accent" MinWidth="110" HorizontalContentAlignment="Center" />
                                        <ComboBox DockPanel.Dock="Right" SelectedIndex="{Binding ScriptKindIndex}" Width="170" Margin="0,0,10,0"
                                                  ToolTip.Tip="{l:Tr Scripts.KindTip}">
                                            <ComboBoxItem Content="Bash" />
                                            <ComboBoxItem Content="Docker Compose" />
                                        </ComboBox>
                                        <CheckBox Content="{l:Tr Scripts.UseSudo}" IsChecked="{Binding ScriptUseSudo}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBox Margin="0,8,0,0" Text="{Binding ScriptBody}" Classes="mono"
                                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top" />
                                </DockPanel>
                            </Grid>

                            <TextBlock Classes="sectionHeader" Text="{l:Tr Settings.Backup}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{l:Tr Backup.ToFolder}" IsChecked="{Binding BackupToFolder}" GroupName="backup" Margin="0,0,24,0" />
                                <RadioButton Content="{l:Tr Backup.ToServer}" IsChecked="{Binding BackupToSsh}" GroupName="backup" />
                            </StackPanel>
                            <Grid Margin="0,8,0,0" ColumnDefinitions="*,Auto" IsVisible="{Binding BackupToFolder}">
                                <TextBox Text="{Binding BackupFolder, UpdateSourceTrigger=LostFocus}" />
                                <Button Grid.Column="1" Content="{l:Tr Backup.Browse}" Margin="6,0,0,0" Command="{Binding BrowseBackupFolderCommand}" />
                            </Grid>
                            <Grid Margin="0,8,0,0" ColumnDefinitions="*,10,*" IsVisible="{Binding BackupToSsh}">
                                <StackPanel>
                                    <TextBlock Classes="fieldLabel" Text="{l:Tr Backup.Server}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding BackupServers}" DisplayMemberBinding="{Binding Name}" SelectedValueBinding="{Binding Id}"
                                              SelectedValue="{Binding BackupServerId}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Classes="fieldLabel" Text="{l:Tr Backup.RemotePath}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding BackupRemotePath, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{l:Tr Backup.Keep}" VerticalAlignment="Center" />
                                <TextBox Width="60" Margin="10,0,24,0" Text="{Binding BackupKeep, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="{l:Tr Backup.AutoHours}" VerticalAlignment="Center" />
                                <TextBox Width="60" Margin="10,0,0,0" Text="{Binding BackupAutoHours, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="{l:Tr Menu.BackupNow}" Command="{Binding BackupNowCommand}" Classes="accent" Padding="14,5" />
                                <Button Content="{l:Tr Restore.Button}" Command="{Binding RestoreBackupCommand}" Margin="8,0,0,0" Padding="14,5" />
                                <TextBlock Text="{Binding BackupLastResult}" Classes="hint" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <TextBlock Classes="hint" Text="{l:Tr Backup.Hint}" Margin="0,6,0,0" />

                            <TextBlock Classes="sectionHeader" Text="{l:Tr Settings.Mcp}" />
                            <CheckBox Content="{l:Tr Settings.McpEnabled}" IsChecked="{Binding McpEnabled}" />
                            <TextBlock Classes="hint" Margin="0,4,0,0" Text="{l:Tr Settings.McpHint}" />
                            <TextBlock Text="{Binding McpServersText}" Margin="0,6,0,0" />

                            <TextBlock Classes="fieldLabel" Text="{l:Tr Settings.McpClaude}" Margin="0,10,0,4" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding McpClaudeCommand, Mode=OneWay}" IsReadOnly="True" Classes="mono" />
                                <Button Grid.Column="1" Content="{l:Tr ScriptRun.Copy}" Command="{Binding CopyMcpClaudeCommand}" Margin="6,0,0,0" />
                            </Grid>
                            <TextBlock Classes="fieldLabel" Text="{l:Tr Settings.McpCodex}" Margin="0,10,0,4" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding McpCodexConfig, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Classes="mono" />
                                <Button Grid.Column="1" Content="{l:Tr ScriptRun.Copy}" Command="{Binding CopyMcpCodexCommand}" Margin="6,0,0,0" VerticalAlignment="Top" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <CheckBox Content="{l:Tr Settings.McpHttp}" IsChecked="{Binding McpHttpEnabled}" VerticalAlignment="Center" />
                                <TextBlock Text="{l:Tr Settings.McpPort}" VerticalAlignment="Center" Margin="24,0,8,0" />
                                <TextBox Width="80" Text="{Binding McpHttpPort, UpdateSourceTrigger=LostFocus}" />
                                <Button Content="{l:Tr Settings.McpNewToken}" Command="{Binding RegenerateMcpTokenCommand}" Margin="12,0,0,0" Padding="12,4" />
                                <TextBlock Text="{Binding McpHttpStatus}" Classes="hint" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <Grid Margin="0,6,0,0" ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding McpHttpCommand, Mode=OneWay}" IsReadOnly="True" Classes="mono" IsEnabled="{Binding McpHttpEnabled}" />
                                <Button Grid.Column="1" Content="{l:Tr ScriptRun.Copy}" Command="{Binding CopyMcpHttpCommand}" Margin="6,0,0,0" />
                            </Grid>
                            <TextBlock Classes="hint" Margin="0,4,0,0" Text="{l:Tr Settings.McpHttpHint}" />

                            <CheckBox Content="{l:Tr Settings.McpConfirm}" IsChecked="{Binding McpConfirm}" Margin="0,12,0,0" />
                            <CheckBox Content="{l:Tr Settings.McpHideSecrets}" IsChecked="{Binding McpHideSecrets}" Margin="0,8,0,0" />
                            <TextBlock Classes="hint" Margin="28,2,0,0" Text="{l:Tr Settings.McpHideSecretsHint}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{l:Tr Settings.McpLogMb}" VerticalAlignment="Center" />
                                <TextBox Width="60" Margin="10,0,24,0" Text="{Binding McpLogMaxMb, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="{l:Tr Settings.McpLogDays}" VerticalAlignment="Center" />
                                <TextBox Width="60" Margin="10,0,24,0" Text="{Binding McpLogDays, UpdateSourceTrigger=LostFocus}" />
                                <Button Content="{l:Tr Ctx.AgentLog}" Command="{Binding OpenAgentLogCommand}" Padding="12,4" />
                            </StackPanel>
                            <TextBlock Classes="hint" Margin="0,4,0,0" Text="{l:Tr Settings.McpLogHint}" />

                            <TextBlock Classes="sectionHeader" Text="{l:Tr Update.Title}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding VersionText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <Button Content="{l:Tr Update.CheckNow}" Command="{Binding CheckUpdatesCommand}" Margin="14,0,0,0" Padding="12,4" />
                                <Button Content="{l:Tr Update.Install}" Command="{Binding InstallUpdateCommand}" Classes="accent"
                                        Margin="8,0,0,0" Padding="12,4" IsVisible="{Binding UpdateAvailable}" />
                                <Button Content="{l:Tr Update.WhatsNew}" Command="{Binding OpenReleaseCommand}" Margin="8,0,0,0" Padding="12,4" />
                                <TextBlock Text="{Binding UpdateStatus}" Classes="hint" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <ProgressBar Value="{Binding UpdateProgress, Mode=OneWay}" Maximum="100" Height="4" MinHeight="4" Width="360"
                                         HorizontalAlignment="Left" Margin="0,8,0,0" IsVisible="{Binding UpdateBusy}" />
                            <CheckBox Content="{l:Tr Update.Auto}" IsChecked="{Binding CheckUpdates}" Margin="0,8,0,0" />
                            <TextBlock Classes="hint" Text="{l:Tr Update.Hint}" Margin="0,4,0,0" />

                            <TextBlock Classes="sectionHeader" Text="{l:Tr Settings.Terminal}" />
                            <ComboBox x:Name="TerminalBox" SelectedIndex="{Binding TerminalIndex}" Width="360" HorizontalAlignment="Left">
                                <ComboBoxItem x:Name="TermWtTab" Content="{l:Tr Settings.WtTab}" />
                                <ComboBoxItem x:Name="TermWtWindow" Content="{l:Tr Settings.WtWindow}" />
                                <ComboBoxItem x:Name="TermConsole" Content="{l:Tr Settings.Console}" />
                                <ComboBoxItem Content="{l:Tr Settings.BuiltIn}" />
                            </ComboBox>
                            <TextBlock Classes="hint" Text="{Binding TerminalInfo}" Margin="0,4,0,0" />
                            <CheckBox Content="{l:Tr Settings.TermIntegration}" IsChecked="{Binding TerminalIntegration}" Margin="0,10,0,0" />
                            <CheckBox Content="{l:Tr Settings.TermAutoSuggest}" IsChecked="{Binding TerminalAutoSuggest}" Margin="0,4,0,0"
                                      IsEnabled="{Binding TerminalIntegration}" />
                            <TextBlock Classes="hint" Text="{l:Tr Settings.TermSuggestHint}" Margin="0,4,0,0" />
                            <StackPanel x:Name="WtProfileRow">
                                <TextBlock Classes="fieldLabel" Text="{l:Tr Settings.WtProfile}" />
                                <TextBox Width="360" HorizontalAlignment="Left" Text="{Binding WindowsTerminalProfile, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <TextBlock Classes="fieldLabel" Text="{l:Tr Settings.SshPath}" />
                            <TextBox Text="{Binding SshPath, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Classes="hint" Text="{Binding EffectiveSshPath}" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{l:Tr Settings.AliveInterval}" VerticalAlignment="Center" />
                                <TextBox Width="70" Margin="10,0,0,0" Text="{Binding ServerAliveInterval, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <TextBlock Classes="hint" Text="{Binding HelperInfo}" Margin="0,10,0,0" />

                            <TextBlock Classes="sectionHeader" Text="{l:Tr Settings.Data}" />
                            <SelectableTextBlock Text="{Binding DataDir}" TextWrapping="Wrap" />
                            <TextBlock Classes="hint" Margin="0,4,0,0" Text="{l:Tr Settings.DataHint}" />
                            <Button Content="{l:Tr Menu.OpenDataFolder}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Command="{Binding $parent[Window].DataContext.OpenDataFolderCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </c:AppTabControl>
            <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Panel x:Name="PageHost" Margin="14,12,14,12" />
            </Border>

            <!-- status bar -->
            <DockPanel Grid.Row="2" Margin="2,8,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" VerticalAlignment="Center" Margin="0,0,16,0" Opacity="0.7" />
                <StackPanel>
                    <TextBlock Text="{Binding AgentStatus}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
