<Window x:Class="Quaykeep.Views.NetworkMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Quaykeep.Localization"
        Title="{l:Tr Map.Title}" Width="1320" Height="840" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="PlanText" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.8" />
                <Button x:Name="DiscardButton" Content="{l:Tr Map.Discard}" Click="OnDiscard" Style="{StaticResource ToolbarButton}" IsEnabled="False" />
                <Button x:Name="ApplyButton" Click="OnApply" Style="{DynamicResource AccentButtonStyle}" Padding="16,5" IsEnabled="False">
                    <TextBlock x:Name="ApplyText" Text="{l:Tr Map.Apply}" />
                </Button>
            </StackPanel>
            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Click="OnRefreshAll" Style="{StaticResource ToolbarButton}" ToolTip="{l:Tr Map.RefreshTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0" />
                        <TextBlock Text="{l:Tr Map.Refresh}" />
                    </StackPanel>
                </Button>
                <Button Content="{l:Tr Map.AutoLayout}" Click="OnAutoLayout" Style="{StaticResource ToolbarButton}" ToolTip="{l:Tr Map.AutoLayoutTip}" />
                <Button Content="{l:Tr Map.Fit}" Click="OnFit" Style="{StaticResource ToolbarButton}" />
                <CheckBox x:Name="FirewallBox" Content="{l:Tr Map.ShowFirewall}" IsChecked="True" Click="OnOptionChanged" Margin="10,0,16,0"
                          VerticalAlignment="Center" ToolTip="{l:Tr Map.ShowFirewallTip}" />
                <CheckBox x:Name="OnlyLinkedBox" Content="{l:Tr Map.OnlyLinked}" Click="OnOptionChanged" VerticalAlignment="Center" />
            </WrapPanel>
        </DockPanel>
        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Text="{l:Tr Map.Hint}" Margin="0,8,0,8" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>
            <Border CornerRadius="6" BorderThickness="1" ClipToBounds="True"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="OnWheel">
                    <Canvas x:Name="Board" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" MouseLeftButtonDown="OnBoardDown" MouseMove="OnBoardMove"
                            MouseLeftButtonUp="OnBoardUp">
                        <Canvas.LayoutTransform>
                            <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
                        </Canvas.LayoutTransform>
                    </Canvas>
                </ScrollViewer>
            </Border>
            <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" Text="{l:Tr Map.Empty}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="460" TextAlignment="Center" />

            <Border Grid.Column="2" CornerRadius="6" BorderThickness="1" Padding="14,12"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Details" />
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBox x:Name="Log" Grid.Row="3" Margin="0,12,0,0" Height="96" IsReadOnly="True" TextWrapping="Wrap"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" />

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <ProgressBar x:Name="Busy" DockPanel.Dock="Left" IsIndeterminate="True" Width="120" Height="4" Visibility="Hidden" />
            <Button DockPanel.Dock="Right" Content="{l:Tr Common.Close}" IsCancel="True" Click="OnClose" Style="{StaticResource DialogButton}" />
            <WrapPanel x:Name="Legend" VerticalAlignment="Center" Margin="16,0,0,0" />
        </DockPanel>
    </Grid>
</Window>
