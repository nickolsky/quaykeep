<UserControl x:Class="Quaykeep.Views.FilePanelView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Quaykeep.Localization"
             xmlns:ic="using:FluentIcons.Avalonia">
    <UserControl.Styles>
        <!-- Far-like rows: a cursor bar (the selected row), marked files in the caution colour, no cell borders -->
        <Style Selector="DataGrid#Grid DataGridRow.marked DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="DataGrid#Grid DataGridCell">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="DataGrid#Grid DataGridCell:focus /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.panel">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="TextBlock.fcell">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="6,0,4,0" />
        </Style>
    </UserControl.Styles>
    <Border x:Name="Frame" BorderThickness="0,2,0,0" BorderBrush="Transparent" Padding="0,6,0,0">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="True">
                <ic:SymbolIcon DockPanel.Dock="Left" Symbol="{Binding Icon}" FontSize="16" VerticalAlignment="Center" Margin="2,0,6,0" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                           MaxWidth="200" TextTrimming="CharacterEllipsis" />
                <Button DockPanel.Dock="Right" Classes="panel" Click="OnRefresh" ToolTip.Tip="{l:Tr Files.Refresh}">
                    <ic:SymbolIcon Symbol="ArrowSync" FontSize="14" />
                </Button>
                <Button DockPanel.Dock="Right" Classes="panel" Click="OnHome" ToolTip.Tip="{l:Tr Files.Home}">
                    <ic:SymbolIcon Symbol="Home" FontSize="14" />
                </Button>
                <Button DockPanel.Dock="Right" Classes="panel" Click="OnUp" ToolTip.Tip="{l:Tr Files.Up}">
                    <ic:SymbolIcon Symbol="ArrowUp" FontSize="14" />
                </Button>
                <TextBox x:Name="PathBox" Text="{Binding PathEdit}" KeyDown="OnPathKey" Classes="mono" FontSize="13"
                         VerticalContentAlignment="Center" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Classes="hint" Margin="2,6,0,0" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
            <Grid>
                <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None"
                          CanUserReorderColumns="False" CanUserSortColumns="True" CanUserResizeColumns="True"
                          DragDrop.AllowDrop="True" RowHeight="26">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{l:Tr Col.Name}" Width="*" MinWidth="120" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Opacity="{Binding Opacity}" Margin="6,0,4,0">
                                        <ic:SymbolIcon Symbol="{Binding Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.8" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Tr Files.Size}" Width="80" SortMemberPath="Item.Size">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" Classes="fcell" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Tr Files.Modified}" Width="120" SortMemberPath="Item.Modified">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ModifiedText}" Classes="fcell" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Tr Files.Permissions}" Width="90" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Permissions}" Classes="fcell mono" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Tr Files.Owner}" Width="100" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Owner}" Classes="fcell" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu x:Name="Menu">
                            <MenuItem x:Name="MiOpen" Header="{l:Tr Files.Open}" InputGesture="Enter" Click="OnMenuOpen" />
                            <MenuItem x:Name="MiEdit" Header="{l:Tr Files.Edit}" InputGesture="F4" Click="OnMenuEdit" />
                            <MenuItem x:Name="MiCopy" InputGesture="F5" Click="OnMenuCopy" />
                            <MenuItem x:Name="MiMove" InputGesture="F6" Click="OnMenuMove" />
                            <Separator />
                            <MenuItem x:Name="MiRename" Header="{l:Tr Files.Rename}" InputGesture="F2" Click="OnMenuRename" />
                            <MenuItem x:Name="MiChmod" Header="{l:Tr Files.Chmod}" Click="OnMenuChmod" />
                            <MenuItem x:Name="MiCopyPath" Header="{l:Tr Files.CopyPath}" Click="OnMenuCopyPath" />
                            <MenuItem x:Name="MiDelete" Header="{l:Tr Files.Delete}" InputGesture="F8" Click="OnMenuDelete" />
                            <Separator />
                            <MenuItem Header="{l:Tr Files.MarkMask}" InputGesture="Add" Click="OnMenuMarkMask" />
                            <MenuItem Header="{l:Tr Files.UnmarkMask}" InputGesture="Subtract" Click="OnMenuUnmarkMask" />
                            <MenuItem Header="{l:Tr Files.InvertMarks}" InputGesture="Multiply" Click="OnMenuInvert" />
                            <Separator />
                            <MenuItem Header="{l:Tr Files.NewFolder}" InputGesture="F7" Click="OnMenuNewFolder" />
                            <MenuItem x:Name="MiNewFile" Header="{l:Tr Files.NewFile}" InputGesture="Shift+F4" Click="OnMenuNewFile" />
                            <MenuItem x:Name="MiTerminal" Header="{l:Tr Files.TerminalHere}" Click="OnMenuTerminal" />
                            <MenuItem x:Name="MiExplorer" Header="{l:Tr Files.Explorer}" Click="OnMenuExplorer" />
                            <MenuItem Header="{l:Tr Files.ShowHidden}" InputGesture="Ctrl+H" ToggleType="CheckBox"
                                      IsChecked="{Binding ShowHidden, Mode=TwoWay}" />
                            <MenuItem Header="{l:Tr Files.Refresh}" InputGesture="Ctrl+R" Click="OnRefresh" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
                <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0.85"
                        IsVisible="{Binding HasError}" VerticalAlignment="Bottom" Padding="10,8"
                        BorderBrush="{DynamicResource SystemFillColorCriticalBrush}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{l:Tr Files.Retry}" Click="OnRetry" Margin="10,0,0,0" Padding="12,4" />
                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DockPanel>
                </Border>
                <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="2" MinHeight="2" Margin="0,30,0,0"
                             IsVisible="{Binding Busy}" />
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
