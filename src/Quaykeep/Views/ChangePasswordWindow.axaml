<v:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Quaykeep.Views"
        xmlns:l="using:Quaykeep.Localization"
        x:Class="Quaykeep.Views.ChangePasswordWindow"
        Title="{l:Tr ChangePwd.Title}" Width="420" SizeToContent="Height" CanResize="False">
    <StackPanel Margin="24,16,24,20">
        <TextBlock Classes="fieldLabel" Text="{l:Tr ChangePwd.Current}" />
        <TextBox x:Name="Current" PasswordChar="•" />
        <TextBlock Classes="fieldLabel" Text="{l:Tr ChangePwd.New}" />
        <TextBox x:Name="New" PasswordChar="•" />
        <TextBlock Classes="fieldLabel" Text="{l:Tr ChangePwd.Repeat}" />
        <TextBox x:Name="Confirm" PasswordChar="•" />
        <TextBlock x:Name="Error" Foreground="#E0443E" TextWrapping="Wrap" Margin="0,10,0,0" IsVisible="False" />
        <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="4" MinHeight="4" Margin="0,12,0,0" Opacity="0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="{l:Tr ChangePwd.Change}" IsDefault="True" Click="OnOk"
                    Classes="accent" MinWidth="100" HorizontalContentAlignment="Center" />
            <Button Content="{l:Tr Common.Cancel}" IsCancel="True" Classes="dialog" />
        </StackPanel>
    </StackPanel>
</v:DialogWindow>
