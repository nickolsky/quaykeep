<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Quaykeep.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- Fluent's window background (Avalonia's dark default is pure black) -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
        </Style>

        <!-- ================= text ================= -->
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBox.mono">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- ================= buttons ================= -->
        <Style Selector="Button.toolbar">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="12,5" />
        </Style>
        <Style Selector="Button.dialog">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- a flat icon button (tab close, small tool buttons) -->
        <Style Selector="Button.flat">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- ================= tabs that look like tabs ================= -->
        <Style Selector="TabControl.cards">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel>
                        <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Margin="10,0,0,-1" ZIndex="1">
                            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </ScrollViewer>
                        <Border CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <ContentPresenter Name="PART_SelectedContentHost" Margin="14,12,14,12"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter>
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="TabControl.cards > TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="Bd" CornerRadius="7,7,0,0" BorderThickness="1,1,1,0" Padding="18,8,18,9"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="Transparent" Cursor="Hand">
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <Border Name="Accent" Height="3" CornerRadius="1.5" Margin="14,0,14,0" VerticalAlignment="Top"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" IsVisible="False" />
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabControl.cards > TabItem:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource ControlStrongFillColorDisabledBrush}" />
        </Style>
        <Style Selector="TabControl.cards > TabItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="TabControl.cards > TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ZIndex" Value="2" />
        </Style>
        <Style Selector="TabControl.cards > TabItem:selected /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style Selector="TabControl.cards > TabItem:selected /template/ Border#Accent">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, Liberation Mono, monospace</FontFamily>

            <!-- The WPF Fluent theme's brush names, so the views keep their colors on every OS. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4000000" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9E000000" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#72000000" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#9D5D00" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#005FB7" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="ControlStrongFillColorDisabledBrush" Color="#51000000" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#72000000" />
                    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#F9F9F9" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#09000000" />
                    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#06000000" />
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#0F000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#87FFFFFF" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FCE100" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#60CDFF" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#19000000" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="ControlStrongFillColorDisabledBrush" Color="#3FFFFFFF" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#8BFFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#202020" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#282828" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#2C2C2C" />
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#15FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#33000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
