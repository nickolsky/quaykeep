<Window x:Class="SshManager.Views.PingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SshManager.Localization"
        Width="560" Height="460" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True">
    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Header" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Margin="0,4,0,10">
            <TextBlock x:Name="Stats" TextWrapping="Wrap" />
            <TextBlock x:Name="Rtt" Style="{StaticResource Hint}" />
            <TextBlock x:Name="JumpNote" Style="{StaticResource Hint}" Text="{l:Tr Ping.JumpHost}" Visibility="Collapsed" Margin="0,4,0,0" />
        </StackPanel>
        <TextBox x:Name="Log" Grid.Row="2" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        <TextBlock x:Name="Blocked" Grid.Row="3" Style="{StaticResource Hint}" Margin="0,8,0,0" Visibility="Collapsed" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ToggleButton" Content="{l:Tr Ping.Stop}" Click="OnToggle" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="{l:Tr ScriptRun.Copy}" Click="OnCopy" MinWidth="100" Margin="0,0,8,0" />
            <Button Content="{l:Tr Common.Close}" IsCancel="True" IsDefault="True" MinWidth="100" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
